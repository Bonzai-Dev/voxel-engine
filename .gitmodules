[submodule "thirdparty/SDL"]
	path = thirdparty/SDL
	url = https://github.com/libsdl-org/SDL.git
[submodule "thirdparty/glm"]
	path = thirdparty/glm
	url = https://github.com/g-truc/glm.git
[submodule "thirdparty/simdjson"]
	path = thirdparty/simdjson
	url = https://github.com/simdjson/simdjson.git
[submodule "thirdparty/slang"]
	path = thirdparty/slang
	url = https://github.com/shader-slang/slang.git
[submodule "thirdparty/spdlog"]
	path = thirdparty/spdlog
	url = https://github.com/gabime/spdlog.git
[submodule "thirdparty/vulkan/VulkanMemoryAllocator"]
	path = thirdparty/vulkan/VulkanMemoryAllocator
	url = https://github.com/GPUOpen-LibrariesAndSDKs/VulkanMemoryAllocator.git
[submodule "thirdparty/vulkan/volk"]
	path = thirdparty/vulkan/volk
	url = https://github.com/zeux/volk.git
[submodule "thirdparty/vulkan/Vulkan-Headers"]
	path = thirdparty/vulkan/Vulkan-Headers
	url = https://github.com/KhronosGroup/Vulkan-Headers.git
